# ---- Telegram (required) -------------------------------------------------
# Token from @BotFather for the bot you programmed.
TELEGRAM_BOT_TOKEN=

# Chat IDs whose posts are treated as incoming alerts (comma-separated).
# For a channel the bot is admin of, this is the channel's numeric id
# (usually negative, e.g. -1001234567890). Leave empty to listen everywhere
# (handy for first-run testing — tighten before going live).
TELEGRAM_SOURCE_CHAT_IDS=

# Chat IDs allowed to issue /commands and receive trade notifications.
# Your own user id is a good start. Empty = anyone (not recommended).
TELEGRAM_ADMIN_CHAT_IDS=

# Where to send trade notifications (defaults to first admin id).
TELEGRAM_NOTIFY_CHAT_ID=

# Long-poll timeout in seconds.
TELEGRAM_POLL_TIMEOUT=30

# ---- Storage / config ----------------------------------------------------
COPYTRADE_DB=copytrade.db
# COPYTRADE_FILTERS=config/filters.yaml

# ---- Live trading (Polymarket) — leave off until ready -------------------
# Master arming switch. Must be true AND mode=live before any real order.
LIVE_TRADING=false
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER=
# Optional pre-derived API creds (otherwise derived from the private key):
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
POLYMARKET_HOST=https://clob.polymarket.com
